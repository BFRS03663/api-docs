# Copy to .env and fill in. Never commit .env.

PORT=8080
# Host ports published by docker compose (change if 8080/5173 are busy on your machine)
BACKEND_PORT=8080
FRONTEND_PORT=5173
GIN_MODE=debug

# Mongo (docker-compose service name is "mongo")
MONGO_URI=mongodb://mongo:27017
MONGO_DB=apidocs

# Admin login. Generate the hash with: make hash-password (paste the whole line it prints).
# Keep the single quotes: bcrypt hashes contain '$', which docker compose would otherwise interpolate.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''

# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=''

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Try-it proxy (/api/v1/proxy) and URL imports. PROXY_ALLOWED_HOSTS limits the
# hosts the portal will call on a reader's behalf (comma-separated; subdomains
# included), e.g. shiprocket.in,petstore3.swagger.io. Empty = any public host.
# Private/loopback targets are always refused unless PROXY_ALLOW_PRIVATE=true.
PROXY_ALLOWED_HOSTS=
PROXY_ALLOW_PRIVATE=false

# Branding shown by the frontend shell and Scalar theme
VITE_SITE_NAME='Shiprocket API'
# Used by the backend in llms.txt (keep in sync with VITE_SITE_NAME)
SITE_NAME='Shiprocket API'
VITE_SITE_LOGO=/logo.jpg
VITE_ACCENT='#EF5B25'
